# Required
GEMINI_API_KEY=AIza...
RECAPTCHA_SECRET_KEY=...
# Public reCAPTCHA site key — gets injected into static/index.html at serve time.
# Without this, the front-end will ship with the placeholder and grecaptcha will not load.
RECAPTCHA_SITE_KEY=6Lc...

# Optional — defaults to gemini-2.5-flash (generous free tier)
# Other options: gemini-2.5-pro (better quality, paid), gemini-2.5-flash-lite (fastest)
GEMINI_MODEL=gemini-2.5-flash

# Optional — needed only for email tracking + shareable gallery
DATABASE_URL=postgresql://user:password@localhost:5432/findthefuckup
